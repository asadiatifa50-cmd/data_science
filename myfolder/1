values = [12, -5, 0, 7, -3, 0, 18, -1] 

positive_values = []
Negative_values =[] 
zero = []

for value in values:
    if value>0:
        positive_values .append (value)
    elif value<0:
        Negative_values .append (value)
    else:
        zero .append (value)

print ("positive:", positive_values)
print ("Negative:", Negative_values)
print ("zero:", zero)
print ("counts", 
       len (positive_values),
       len (Negative_values),
       len (zero))
